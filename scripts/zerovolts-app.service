# /etc/systemd/system/zerovolts-ap.service
[Unit]
Description=ZeroVolts UI Application
Requires=zv-hid.service
After=zv-hid.service

[Service]
Type=simple
WorkingDirectory=/home/zerovolts/git/zerovolts-ui
ExecStart=/home/zerovolts/git/zerovolts-ui/bin/zero-volts-ui
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

