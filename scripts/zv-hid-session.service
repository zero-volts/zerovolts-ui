# Template filled by install-hid.sh; do not copy directly to /etc/systemd.

[Unit]
Description=ZeroVolts HID session (once per UI activation)
Requires=zv-hid-gadget.service
After=zv-hid-gadget.service
PartOf=zv-hid-gadget.service

[Service]
Type=exec
WorkingDirectory=@PROJECT_ROOT@
Environment="ZV_PROJECT_ROOT=@PROJECT_ROOT@"
ExecStart=/usr/bin/python3 /usr/local/lib/zerovolts/hid/zv-hid-session.py
KillMode=control-group
TimeoutStopSec=3
Restart=no
